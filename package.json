{
  "name": "homebridge-create-ceiling-fan",
  "displayName": "Homebridge Create Ceiling Fan",
  "type": "module",
  "version": "2.3.1",
  "private": false,
  "description": "Free the full potential of your ceiling fan with Homebridge",
  "author": "Thibaut Mottet",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moifort/homebridge-create-fan.git"
  },
  "bugs": {
    "url": "https://github.com/moifort/homebridge-create-fan/issues"
  },
  "keywords": [
    "homebridge-plugin",
    "homebridge",
    "homekit",
    "tuya",
    "ceiling-fan",
    "fan",
    "create"
  ],
  "main": "dist/index.js",
  "files": [
    "dist",
    "config.schema.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^20 || ^22 || ^24",
    "homebridge": "^1.8.0 || ^2.0.0-beta.0 || ^2.0.0"
  },
  "scripts": {
    "build": "rimraf ./dist && tsc",
    "lint": "eslint . --max-warnings=0",
