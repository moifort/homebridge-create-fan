    "watch": "npm run build && npm link && nodemon"
  },
  "dependencies": {
    "tuyapi": "7.7.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.15.0",
    "homebridge": "2.5.0",
    "nodemon": "3.1.14",
    "rimraf": "6.1.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0"
  },
  "overrides": {
    "nodemon": {
      "minimatch": "11.0.9"
    }
  }
